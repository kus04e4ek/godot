+bool SDL_GetAudioDeviceLatency(SDL_AudioDeviceID devid, float *latency)
+{
+    if (!latency) {
+        return SDL_InvalidParamError("latency");
+    }
+
+    bool result = false;
+    SDL_AudioDevice *device = ObtainPhysicalAudioDeviceDefaultAllowed(devid);
+    if (device) {
